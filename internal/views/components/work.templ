package components

import (
	"ozkansen.com/internal/content"
	"ozkansen.com/internal/i18n"
)

templ Work(tr *i18n.Translator, site *content.Site) {
	<section id="work" class="py-24">
		<div class="max-w-6xl mx-auto px-6">
			<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-14">
				<div>
					<p class="reveal text-xs font-medium text-accent tracking-widest uppercase mb-3">{ tr.T("work.eyebrow") }</p>
					<h2 class="reveal d1 font-display font-bold text-4xl md:text-5xl text-zinc-900 dark:text-white">{ tr.T("work.title") }</h2>
				</div>
				<a href="/projects" class="reveal d1 text-sm font-medium text-zinc-500 dark:text-zinc-400 hover:text-accent transition-colors self-start sm:self-auto nl">{ tr.T("work.all") } →</a>
			</div>

			<div class="grid md:grid-cols-2 gap-6">
				if len(site.Projects) > 0 {
					@ProjectCard(tr, site.Projects[0], true)
				}
				if len(site.Projects) > 1 {
					for _, project := range site.Projects[1:] {
						@ProjectCard(tr, project, false)
					}
				}
			</div>
		</div>
	</section>
}

templ ProjectCard(tr *i18n.Translator, project *content.Project, featured bool) {
	if featured {
		<article class="card-h reveal d1 group rounded-2xl overflow-hidden bg-zinc-100 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 hover:border-accent md:row-span-2">
			<div class="pf w-full h-64 md:h-80">
				<img src={ project.Image } alt={ project.Title(string(tr.Locale())) } loading="lazy"/>
			</div>
			<div class="p-7">
				<div class="flex flex-wrap gap-2 mb-4">
					for _, tag := range project.Tags(string(tr.Locale())) {
						<span class="text-xs bg-orange-50 dark:bg-zinc-800 text-accent border border-orange-200 dark:border-zinc-700 px-3 py-1 rounded-full">{ tag }</span>
					}
				</div>
				<a href="/projects">
					<h3 class="font-display font-bold text-2xl text-zinc-900 dark:text-white mb-2">{ project.Title(string(tr.Locale())) }</h3>
				</a>
				<p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed mb-5">{ project.BodyText(string(tr.Locale())) }</p>
				<a href="/projects" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-900 dark:text-white nl">{ tr.T("work.cta") } <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></a>
			</div>
		</article>
	} else {
		<article class="card-h reveal group rounded-2xl overflow-hidden bg-zinc-100 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 hover:border-accent">
			<div class="pf w-full h-48">
				<img src={ project.Image } alt={ project.Title(string(tr.Locale())) } loading="lazy"/>
			</div>
			<div class="p-6">
				<div class="flex flex-wrap gap-2 mb-3">
					for _, tag := range project.Tags(string(tr.Locale())) {
						<span class="text-xs bg-orange-50 dark:bg-zinc-800 text-accent border border-orange-200 dark:border-zinc-700 px-3 py-1 rounded-full">{ tag }</span>
					}
				</div>
				<a href="/projects">
					<h3 class="font-display font-bold text-xl text-zinc-900 dark:text-white mb-1.5">{ project.Title(string(tr.Locale())) }</h3>
				</a>
				<p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed mb-4">{ project.BodyText(string(tr.Locale())) }</p>
				<a href="/projects" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-900 dark:text-white nl">{ tr.T("work.cta") } →</a>
			</div>
		</article>
	}
}