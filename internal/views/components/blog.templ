package components

import (
	"ozkansen.com/internal/content"
	"ozkansen.com/internal/i18n"
)

templ Blog(tr *i18n.Translator, site *content.Site) {
	<section id="blog" class="py-24 bg-zinc-50 dark:bg-zinc-900/40">
		<div class="max-w-6xl mx-auto px-6">
			<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-14">
				<div>
					<p class="reveal text-xs font-medium text-accent tracking-widest uppercase mb-3">{ tr.T("blog.eyebrow") }</p>
					<h2 class="reveal d1 font-display font-bold text-4xl md:text-5xl text-zinc-900 dark:text-white">{ tr.T("blog.title") }</h2>
				</div>
				<a href="/blog" class="reveal d1 text-sm font-medium text-zinc-500 dark:text-zinc-400 hover:text-accent transition-colors self-start sm:self-auto nl">{ tr.T("blog.all") } →</a>
			</div>

			<div class="grid md:grid-cols-3 gap-6">
				for i, post := range site.Posts {
					if i == 0 {
						<article class="reveal d1 card-h group bg-white dark:bg-zinc-900 rounded-2xl overflow-hidden border border-zinc-100 dark:border-zinc-800 hover:border-accent">
							<div class="pf w-full h-44">
								<img src={ post.Image } alt={ post.Title(string(tr.Locale())) } loading="lazy"/>
							</div>
							<div class="p-6">
								<div class="flex items-center gap-3 mb-3">
									for _, tag := range post.Tags(string(tr.Locale())) {
										<span class="text-xs bg-orange-50 dark:bg-zinc-800 text-accent border border-orange-200 dark:border-zinc-700 px-2.5 py-1 rounded-full">{ tag }</span>
									}
									<span class="text-xs text-zinc-400">{ post.Date(string(tr.Locale())) }</span>
								</div>
								<a href="/blog">
									<h3 class="font-display font-bold text-lg text-zinc-900 dark:text-white mb-2 group-hover:text-accent transition-colors">{ post.Title(string(tr.Locale())) }</h3>
								</a>
								<p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed mb-4">{ post.BodyText(string(tr.Locale())) }</p>
								<a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-900 dark:text-white nl">{ tr.T("blog.cta") } →</a>
							</div>
						</article>
					} else if i == 1 {
						<article class="reveal d2 card-h group bg-white dark:bg-zinc-900 rounded-2xl overflow-hidden border border-zinc-100 dark:border-zinc-800 hover:border-accent">
							<div class="pf w-full h-44">
								<img src={ post.Image } alt={ post.Title(string(tr.Locale())) } loading="lazy"/>
							</div>
							<div class="p-6">
								<div class="flex items-center gap-3 mb-3">
									for _, tag := range post.Tags(string(tr.Locale())) {
										<span class="text-xs bg-orange-50 dark:bg-zinc-800 text-accent border border-orange-200 dark:border-zinc-700 px-2.5 py-1 rounded-full">{ tag }</span>
									}
									<span class="text-xs text-zinc-400">{ post.Date(string(tr.Locale())) }</span>
								</div>
								<a href="/blog">
									<h3 class="font-display font-bold text-lg text-zinc-900 dark:text-white mb-2 group-hover:text-accent transition-colors">{ post.Title(string(tr.Locale())) }</h3>
								</a>
								<p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed mb-4">{ post.BodyText(string(tr.Locale())) }</p>
								<a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-900 dark:text-white nl">{ tr.T("blog.cta") } →</a>
							</div>
						</article>
					} else {
						<article class="reveal d3 card-h group bg-white dark:bg-zinc-900 rounded-2xl overflow-hidden border border-zinc-100 dark:border-zinc-800 hover:border-accent">
							<div class="pf w-full h-44">
								<img src={ post.Image } alt={ post.Title(string(tr.Locale())) } loading="lazy"/>
							</div>
							<div class="p-6">
								<div class="flex items-center gap-3 mb-3">
									for _, tag := range post.Tags(string(tr.Locale())) {
										<span class="text-xs bg-orange-50 dark:bg-zinc-800 text-accent border border-orange-200 dark:border-zinc-700 px-2.5 py-1 rounded-full">{ tag }</span>
									}
									<span class="text-xs text-zinc-400">{ post.Date(string(tr.Locale())) }</span>
								</div>
								<a href="/blog">
									<h3 class="font-display font-bold text-lg text-zinc-900 dark:text-white mb-2 group-hover:text-accent transition-colors">{ post.Title(string(tr.Locale())) }</h3>
								</a>
								<p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed mb-4">{ post.BodyText(string(tr.Locale())) }</p>
								<a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-900 dark:text-white nl">{ tr.T("blog.cta") } →</a>
							</div>
						</article>
					}
				}
			</div>
		</div>
	</section>
}