package components

import "ozkansen.com/internal/i18n"

templ About(tr *i18n.Translator) {
	<section id="about" class="py-24 bg-zinc-50 dark:bg-zinc-900/40">
		<div class="max-w-6xl mx-auto px-6">
			<div class="grid md:grid-cols-2 gap-16 items-center">
				<div class="reveal order-2 md:order-1">
					<div class="pf w-full aspect-square max-w-sm mx-auto rounded-3xl">
						<img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=700&q=80" alt={ tr.T("about.photo.alt") } loading="lazy"/>
					</div>
				</div>
				<div class="order-1 md:order-2">
					<p class="reveal text-xs font-medium text-accent tracking-widest uppercase mb-3">{ tr.T("about.eyebrow") }</p>
					<h2 class="reveal d1 font-display font-bold text-4xl md:text-5xl text-zinc-900 dark:text-white leading-tight mb-6">{ tr.T("about.title1") }<br/>{ tr.T("about.title2") }</h2>
					<p class="reveal d2 text-zinc-500 dark:text-zinc-400 leading-relaxed mb-4">{ tr.T("about.p1") }</p>
					<p class="reveal d3 text-zinc-500 dark:text-zinc-400 leading-relaxed mb-8">{ tr.T("about.p2") }</p>
					<div class="reveal d4">
						<p class="text-xs font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-widest mb-3">{ tr.T("about.stack") }</p>
						<div class="flex flex-wrap gap-2" role="list" aria-label="Skills">
							<span role="listitem" class="stag text-sm bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 px-3.5 py-1.5 rounded-full hover:border-accent">Tailwind CSS</span>
							<span role="listitem" class="stag text-sm bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 px-3.5 py-1.5 rounded-full hover:border-accent">Alpine.js</span>
							<span role="listitem" class="stag text-sm bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 px-3.5 py-1.5 rounded-full hover:border-accent">Figma</span>
							<span role="listitem" class="stag text-sm bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 px-3.5 py-1.5 rounded-full hover:border-accent">HTML / CSS</span>
							<span role="listitem" class="stag text-sm bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 px-3.5 py-1.5 rounded-full hover:border-accent">JavaScript</span>
							<span role="listitem" class="stag text-sm bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 px-3.5 py-1.5 rounded-full hover:border-accent">Go</span>
							<span role="listitem" class="stag text-sm bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 px-3.5 py-1.5 rounded-full hover:border-accent">React</span>
							<span role="listitem" class="stag text-sm bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 px-3.5 py-1.5 rounded-full hover:border-accent">PostgreSQL</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}
