package layout

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="tr">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/styles.css"/>
			<!-- HTMX ve Alpine.js CDN -->
			<script src="https://unpkg.com/htmx.org@1.9.10" defer></script>
			<script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
		</head>
		<body class="bg-slate-900 text-slate-100 antialiased min-h-screen flex flex-col">
			<header class="border-b border-slate-800 p-4">
				<div class="max-w-4xl mx-auto flex justify-between items-center">
					<a href="/" class="font-bold text-xl text-indigo-400">Personal Space</a>
					<nav class="space-x-4 text-sm font-medium">
						<a href="/" class="hover:text-indigo-400 transition">Anasayfa</a>
						<a href="/projects" class="hover:text-indigo-400 transition">Projeler</a>
					</nav>
				</div>
			</header>

			<main class="flex-1 max-w-4xl w-full mx-auto p-4 py-8">
				{ children... }
			</main>

			<footer class="border-t border-slate-800 p-4 text-center text-slate-500 text-sm">
				© 2026 Tüm hakları saklıdır.
			</footer>
		</body>
	</html>
}